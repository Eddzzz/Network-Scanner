# Carpeta local sincronizada por OneDrive para Windows. No requiere Client ID.
ONEDRIVE_LOCAL_DIR=C:/Users/walte/OneDrive/Nube
# Guarda JSON y CSV automáticamente después de cada escaneo exitoso.
ONEDRIVE_AUTO_UPLOAD=true
# Generar con: .\venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(32))"
SCANNER_API_KEY=
